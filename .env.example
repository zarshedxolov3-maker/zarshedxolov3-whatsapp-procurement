# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# WhatsApp Business Cloud API (Meta)
# https://developers.facebook.com/docs/whatsapp/cloud-api
# ──────────────────────────────────────────────────────────────────────────────

# Random string you set in the Meta App Dashboard → Webhooks → Verify token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# App Secret from Meta App Dashboard → Settings → Basic → App Secret
# Used to validate X-Hub-Signature-256 on every inbound webhook request
WHATSAPP_APP_SECRET=your_app_secret_here

# Permanent (or temporary) user access token or system-user token
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# Phone Number ID from Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Graph API version (default: v19.0)
WHATSAPP_API_VERSION=v19.0

# ──────────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────────

# Path to the SQLite database file (relative to project root)
DATABASE_PATH=./data/tradebay.db

# ──────────────────────────────────────────────────────────────────────────────
# Pricing
# ──────────────────────────────────────────────────────────────────────────────

# Cargo / freight rate in USD per kg
CARGO_RATE_PER_KG=5

# Default target margin percentage used when suggesting a selling price
DEFAULT_MARGIN_PERCENT=15

# Default display currency
DEFAULT_CURRENCY=USD

# ──────────────────────────────────────────────────────────────────────────────
# Titan Moscow (competitor price reference)
# ──────────────────────────────────────────────────────────────────────────────
TITAN_MOSCOW_API_URL=https://api.titanmoscow.ru/v1
TITAN_MOSCOW_API_KEY=your_titan_api_key_here
